<Application x:Class="WiFiAnalyzer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:WiFiAnalyzer.Converters"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 初期言語リソース（後からコードで差し替え可能） -->
                <ResourceDictionary Source="Resources/Strings.ja-JP.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- コンバーターの登録 -->
            <converters:SignalToBrushConverter x:Key="SignalToBrushConverter" />
            <converters:BandToBadgeBrushConverter x:Key="BandToBadgeBrushConverter" />
            <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <converters:WifiGenerationToBadgeBrushConverter x:Key="WifiGenerationToBadgeBrushConverter" />

            <!-- グローバルスタイル定義 -->
            <FontFamily x:Key="MainFont">Segoe UI Variable, Segoe UI, Meiryo, sans-serif</FontFamily>
            <FontFamily x:Key="CodeFont">Cascadia Mono, Consolas, Courier New, monospace</FontFamily>

            <SolidColorBrush x:Key="AccentColorBrush" Color="#0EA5E9" />
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FAFAFA" />
            <SolidColorBrush x:Key="BorderBrushLight" Color="#E2E8F0" />
            <SolidColorBrush x:Key="ConnectedHighlightBrush" Color="#E0F2FE" />
            <SolidColorBrush x:Key="ConnectedBorderBrush" Color="#38BDF8" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
